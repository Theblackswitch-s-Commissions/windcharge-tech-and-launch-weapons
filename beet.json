{
    "data_pack": {
        "load": [
            "libraries/SwitchLib-v2.0.3.zip",
            "src/datapack"
        ],
        "name": "Efou's Training Ground Datapack"
    },
    "pipeline": [
        "plugins.aliases",
        "flare.beet"
    ],
    "id": "tg",
    "name": "tg",
    "description": "",
    "version": "1.0.2a",
    "require": [
        "flare"
    ],
    "output": "build",
    "meta": {
        "aliases": [
            {
                "regex": "__version__",
                "replace": "v2.0",
                "comment": "The switch lib major version"
            },
            {
                "regex": "__patch__",
                "replace": "patch-3",
                "comment": "The switch lib major version"
            }
        ]
    }
}