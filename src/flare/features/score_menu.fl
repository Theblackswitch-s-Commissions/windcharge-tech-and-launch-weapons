from flare import *
from ..lib.standards import *

score_menu = Objective('score_menu')

# -------------------------------
#  Placement                            
# -------------------------------

add_loot_table('item/score_menu_placer', {
	"type": "minecraft:empty",
	"pools": [
		{
			"rolls": 1,
			"entries": [
				{
					"type": "minecraft:item",
					"name": "minecraft:cod_spawn_egg",
					"functions": [
						{
							"function": "minecraft:set_components",
							"components": {
								"minecraft:enchantment_glint_override": True,
								"minecraft:entity_data": {
									"id": "minecraft:marker",
									"Tags": [
										"place_score_menu_here"
									]
								},
                                "minecraft:custom_name": "Score menu placer"
							}
						}
					]
				}
			]
		}
	]
})

@tick
def check_place_score_menu():
    with @e[type=marker,tag=place_score_menu_here].at(@s).positioned(~ ~1 ~):
        @s.kill()
        place()
        with @e[type=text_display,tag=score_menu].at(@s).rotated(@p).rotated('~ -20'):
            tp @s ~ ~ ~ ~180 ~
            if @s[y_rotation=-45..45]:
                tp @s ~ ~ ~ 0 ~
            if @s[y_rotation=45..135]:
                tp @s ~ ~ ~ 90 ~
            if @s[y_rotation=135..225]:
                tp @s ~ ~ ~ 180 ~
            if @s[y_rotation=225..315]:
                tp @s ~ ~ ~ 270 ~

