# -------------------------------
#  Enabling                            
# -------------------------------

@tag('score_menu/enable')
@export('score_menu/enable')
def enable():
    disable()
    with @e[type=minecraft:text_display,tag=score_menu,tag=main].at(@s).rotated(@s):
        @s.kill()
        place()
        with @e[type=minecraft:text_display,tag=score_menu]:
            tp @s ~ ~ ~ ~ ~

@tag('score_menu/disable')
@export('score_menu/disable')
def disable():
    @e[type=minecraft:text_display,tag=score_menu,tag=!main].kill()

# -------------------------------
#  Updating the scoreboard                            
# -------------------------------

@export('score_menu/update')
def update_menu():
    success_rate = score_menu['#correct'] * 100 / score_menu['#total']

    color = nbt('white')

    if success_rate < 50:
        color = nbt("red")
    if success_rate >= 50 and success_rate < 60:
        color = nbt("gold")
    if success_rate >= 60 and success_rate < 70:
        color = nbt("yellow")
    if success_rate >= 70:
        color = nbt("green")

    execute unless score #streak score_menu <= #record score_menu run scoreboard players operation #record score_menu = #streak score_menu


    modify_streak(score_menu['#streak'])
    modify_record(score_menu['#record'])
    modify_success_rate(success_rate, color)
    modify_total(score_menu['#total'])



@export('score_menu/incr_score')
def incr_score():
    score_menu['#correct'] += 1
    score_menu['#streak'] += 1
    score_menu['#total'] += 1

    update_menu()

    if score_menu['#streak'] % 10 == 0:
        playsound minecraft:entity.armadillo.brush master @a ~ ~ ~ 10 1
        playsound minecraft:entity.player.levelup master @a ~ ~ ~ 10 1.2

        with @n[type=text_display,tag=main].at(@s):
            particle minecraft:wax_off ^ ^1.4 ^0.5 0 0 0 30 20 force

    else:
        playsound minecraft:entity.armadillo.brush master @a ~ ~ ~ 10 1.5
        playsound minecraft:block.note_block.bell master @a ~ ~ ~ 10 1
        
        with @n[type=text_display,tag=main].at(@s):
            particle minecraft:scrape ^ ^1.4 ^0.5 0 0 0 10 5
        
    with @n[type=text_display,tag=streak_counter]:
        @s.transformation.scale = nbt[3.5f, 3.5f, 3.5f]
        @s.interpolation_duration = 1
        with schedule("2t", append=False), @n[type=text_display,tag=streak_counter]:
                @s.transformation.scale = nbt[3.0f, 3.0f, 3.0f]
                @s.interpolation_duration = 3
                @s.start_interpolation = 0




@export('score_menu/reset_streak')
def reset_streak():
    score_menu['#streak'] = 0

    score_menu['#total'] += 1

    update_menu()

@tag('score_menu/reset')
@export('score_menu/reset')
def reset():
    score_menu['#streak'] = 0
    score_menu['#total'] = 0
    score_menu['#correct'] = 0
    score_menu['#record'] = 0

    modify_streak(0)
    modify_success_rate('NaN', 'green')
    modify_total(0)
    
@export('score_menu/modify/streak')
def modify_streak(value: macro):
    @n[type=text_display,tag=score_menu,tag=streak_counter].text = {"text": value, "color": "gold"}


@export('score_menu/modify/total')
def modify_total(value: macro):
    @n[type=text_display,tag=score_menu,tag=total].text = {"text": value, "color": "white"}

@export('score_menu/modify/success_rate')
def modify_success_rate(value: macro, color: macro):
    @n[type=text_display,tag=score_menu,tag=success_rate].text = {"text": f"{value}%", "color": color}

@export('score_menu/modify/record')
def modify_record(value: macro):
    @n[type=text_display,tag=score_menu,tag=streak_record].text = {"text": value, "color": "yellow"}

