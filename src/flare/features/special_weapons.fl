from flare import *

slam_timer = Objective('slam_timer')
poison_timer = Objective('poison_timer')
slow_tick = Objective('tbs.slow_tick', add=False)
random_delay = Objective('tbs.random_delay', add=False)
ID = Objective('tbs.ID', add=False)

# -------------------------------
#  Dash Launching                            
# -------------------------------

add_enchantment('internal/dash', {
	"anvil_cost": 4,
	"description": {
		"text": "This enchantment is used internally. Use at own risk!",
		"color": "red"
	},
	"effects": {
		"minecraft:tick": [
			{
				"effect": {
					"type": "minecraft:apply_impulse",
					"direction": [
						0,
						0,
						1
					],
					"coordinate_scale": [
						1,
						1,
						1
					],
					"magnitude": 2.435
				}
			},
			{
				"effect": {
					"type": "minecraft:run_function",
					"function": "tg:special_weapons/dash/reset"
				}
			}
		]
	},
	"max_cost": {
		"base": 65,
		"per_level_above_first": 9
	},
	"max_level": 3,
	"min_cost": {
		"base": 15,
		"per_level_above_first": 9
	},
	"slots": [
		"saddle"
	],
	"supported_items": "minecraft:saddle",
	"weight": 2
})

@export('special_weapons/dash/reset')
def dash_reset():
    item replace entity @s saddle with air

@export('special_weapons/dash/run')
def dash_run():
    item replace entity @s saddle with minecraft:saddle[minecraft:enchantments={"tg:internal/dash":1}]



