# -------------------------------
#  Give a launchable item                            
# -------------------------------

@tag(f'special_weapons/give_dash')
@export(f'special_weapons/give_dash')
def give_dash(id: macro, components: macro):
    loot give @s loot {
        "pools":[
            {
                "rolls":1,
                "entries": [
                    {
                        "type": "minecraft:item", 
                        "name": "$(id)",
                        "functions": [
                            {
                                "function": "set_components",
                                "components": {
                                    "minecraft:consumable": {"consume_seconds":0.01,"animation":"none","has_consume_particles":False,"sound":"minecraft:intentionally_empty"},
                                    "minecraft:use_cooldown": {"seconds":5},
                                    "minecraft:use_effects": {"can_sprint":True,"speed_multiplier":1},
                                    "minecraft:custom_data": {"tg":{"special_weapon":True, "weapon": "dash"}},
                                    "minecraft:custom_name": {"text": "RClick to dash","color":"green"},
                                    "minecraft:equippable": {"slot": "body","equip_sound":"minecraft:intentionally_empty"}
                                } 
                            },
                            {
                                "function": "set_components",
                                "components": $(components)
                            }
                        ]
                    }
                ]
            }
        ]
    }

