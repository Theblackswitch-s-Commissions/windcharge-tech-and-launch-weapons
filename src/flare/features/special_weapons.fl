# -------------------------------
#  Run tick                            
# -------------------------------

@export('special_weapons/tick', name="special_weapons/tick")
def special_weapons_tick():
    
    if slam_timer[@s] > 0:
        slam_tick()

    poison_weapon_tick()

    # copy the item to the body slot
    if holding_weapon_mainhand:
        item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped
    elif holding_weapon_offhand:
        item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped

    # give back the item if needed
    if @s[tag=GIVE_BACK]:
        @s.remove_tag('GIVE_BACK')

        execute unless items entity @s weapon.mainhand * run return run item replace entity @s weapon.mainhand from entity @s armor.body $no_clear_when_dropped
        execute unless items entity @s weapon.offhand * run return run item replace entity @s weapon.offhand from entity @s armor.body $no_clear_when_dropped

        @s.add_tag('SELECT')
        with summon('chest_minecart'):
            item replace entity @s container.0 from entity @p[tag=SELECT] armor.body
            kill @s
        @s.remove_tag('SELECT')


# -------------------------------
#  Detect right click                            
# -------------------------------

holding_weapon_mainhand = add_predicate('holding/weapon/mainhand', {
	"condition": "minecraft:entity_properties",
	"entity": "this",
	"predicate": {
		"equipment": {
			"mainhand": {
				"predicates": {
					"minecraft:custom_data": {
                        "tg":{
                            "special_weapon":True
                        }
                    }
				}
			}
		}
	}
})

holding_weapon_offhand = add_predicate('holding/weapon/offhand', {
	"condition": "minecraft:entity_properties",
	"entity": "this",
	"predicate": {
		"equipment": {
			"mainhand": {
				"predicates": {
					"minecraft:custom_data": {
                        "tg":{
                            "special_weapon":True
                        }
                    }
				}
			}
		}
	}
})

clear_when_dropped = add_item_modifier('clear_when_dropped', {
	"function": "minecraft:set_custom_data",
	"tag": {
		"tbs.clear_when_dropped": True
	}
})

no_clear_when_dropped = add_item_modifier('clear_when_dropped', {
	"function": "minecraft:set_custom_data",
	"tag": {
		"tbs.clear_when_dropped": False
	}
})

# -------------------------------
#  Detect on ground                            
# -------------------------------

is_on_ground = add_predicate('on_ground', {
	"condition": "minecraft:entity_properties",
	"entity": "this",
	"predicate": {
		"flags": {
			"is_on_ground": True
		}
	}
})

# ------------------------------------------------------------------------------------------------------------------------------------------

@event('minecraft:consume_item', {"item": {"predicates": {"minecraft:custom_data": {"tg":{"special_weapon":True, "weapon": "dash"}}}}}, name="special_weapons/dash")
def use_dash_weapon():
    with at(@s):
        particle minecraft:cloud ~ ~ ~ 0.3 0.3 0.3 0.04 5
        playsound minecraft:entity.breeze.jump master @a ~ ~ ~ 0.5 1
        dash_run()

        if holding_weapon_mainhand:
            item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped
        elif holding_weapon_offhand:
            item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped

        if @s[gamemode=survival] or @s[gamemode=adventure]:
            @s.add_tag('GIVE_BACK')

# ------------------------------------------------------------------------------------------------------------------------------------------

@event('minecraft:consume_item', {"item": {"predicates": {"minecraft:custom_data": {"tg":{"special_weapon":True, "weapon": "slam"}}}}}, name="special_weapons/slam")
def use_slam_weapon():
    with at(@s):
        particle minecraft:trial_spawner_detection ~ ~ ~ 0.3 0.3 0.3 0 50 force
        particle minecraft:gust ~ ~ ~ 0.2 0.1 0.2 0 3
        particle minecraft:item_cobweb ~ ~ ~ 3 3 3 0 30 force

        playsound minecraft:entity.breeze.jump master @a ~ ~ ~ 0.8 0.7
        playsound minecraft:item.armor.equip_chain master @a ~ ~ ~ 1 0.9
        playsound minecraft:block.trial_spawner.detect_player master @a ~ ~ ~ 0.7 1.2

        slam_timer[@s] = 16  
        effect give @s levitation 1 60

        if holding_weapon_mainhand:
            item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped
        elif holding_weapon_offhand:
            item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped

        if @s[gamemode=survival] or @s[gamemode=adventure]:
            @s.add_tag('GIVE_BACK')

@export('special_weapons/slam/anim')
def slam_tick():

    if slam_timer[@s] == 1:
        playsound minecraft:entity.warden.sonic_boom master @a ~ ~ ~ 0.25 2

        effect clear @s levitation
        slam_run()

    slam_timer[@s] -= 1

# ------------------------------------------------------------------------------------------------------------------------------------------

@event('minecraft:consume_item', {"item": {"predicates": {"minecraft:custom_data": {"tg":{"special_weapon":True, "weapon": "cobweb"}}}}}, name="special_weapons/cobweb")
def use_cobweb_weapon():
    with at(@s):
        particle minecraft:item_cobweb ~ ~ ~ 3 3 3 0 20 force
        particle minecraft:white_ash ~ ~ ~ 3 3 3 0 50 force

        playsound minecraft:block.cobweb.break master @a ~ ~ ~ 1 0.9
        playsound minecraft:entity.horse.armor master @a ~ ~ ~ 0.2 1.4

        fill ~-4 ~-4 ~-4 ~4 ~4 ~4 air replace minecraft:cobweb

        if holding_weapon_mainhand:
            item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped
        elif holding_weapon_offhand:
            item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped

        if @s[gamemode=survival] or @s[gamemode=adventure]:
            @s.add_tag('GIVE_BACK')


# ------------------------------------------------------------------------------------------------------------------------------------------

@event('minecraft:consume_item', {"item": {"predicates": {"minecraft:custom_data": {"tg":{"special_weapon":True, "weapon": "poison"}}}}}, name="special_weapons/poison")
def use_poison_weapon():
    with at(@s):
        particle minecraft:cloud ~ ~ ~ 0.3 0.3 0.3 0.1 10

        playsound minecraft:block.trial_spawner.spawn_item master @a ~ ~ ~ 0.5 1
        playsound minecraft:block.sculk.hit master @a ~ ~ ~ 1 0.8
        playsound minecraft:entity.wind_charge.wind_burst master @a ~ ~ ~ 0.2 0.8

        poison_run()

        @s.add_tag('doing_a_poison_dash')
        @s.add_tag('launching')

        if holding_weapon_mainhand:
            item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped
        elif holding_weapon_offhand:
            item replace entity @s armor.body from entity @s weapon.mainhand $clear_when_dropped

        if @s[gamemode=survival] or @s[gamemode=adventure]:
            @s.add_tag('GIVE_BACK')

@export('special_weapons/poison/tick')
def poison_weapon_tick():

    if @s[tag=doing_a_poison_dash,tag=!launching] and is_on_ground:
        @s.remove_tag('doing_a_poison_dash')

    @s.remove_tag('launching')

    with @e[type=marker,tag=poison_cloud].at(@s):
        ID["#search"] = ID[@s]

        if slow_tick['#10'] == random_delay["#10"]:
            particle minecraft:entity_effect{"color":[0.5, 0.7, 0.5, 1.0]} ~ ~ ~ 0.3 0.3 0.3 0.01 10
            particle minecraft:dust{"color":[0.2, 0.5, 0.2],"scale":3} ~ ~ ~ 0.4 0.4 0.4 0 1

        effect give @e[distance=..4,type=!player] minecraft:poison 5 0
        effect give @a[distance=..4,predicate=!theblackswitch:__version__/__patch__/player_id/match_search] minecraft:poison 5 0

        poison_timer[@s] += 1

        if poison_timer[@s] == 80:
            kill @s


    if @s[tag=doing_a_poison_dash]:
        ID["#search"] = ID[@s]
        
        summon marker ~ ~ ~ {Tags:[poison_cloud,INIT]}

        with @e[type=marker,tag=poison_cloud,tag=INIT]:
            ID[@s] = ID["#search"]
            @s.remove_tag('INIT')


        particle minecraft:dust{"color":[0.2, 0.5, 0.2],"scale":4} ~ ~ ~ 0.5 0.5 0.5 0 6
        if slow_tick["#3"] == random_delay["#3"]:
            playsound minecraft:block.sculk.hit master @a ~ ~ ~ 0.2 0.9
