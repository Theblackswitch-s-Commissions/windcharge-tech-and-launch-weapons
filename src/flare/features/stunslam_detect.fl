from flare import *
from .score_menu import *
from .windcharge import *
from ..lib.standards import *

# -------------------------------
#  Detect shield blocking                            
# -------------------------------

@event('minecraft:player_hurt_entity',
    {
        "damage": {
            "blocked": True
        },
        "player": {
            "equipment": {
                "mainhand": {
                    "items": "#minecraft:axes"
                }
            }
        }
    }, 
    name="stunslam_detect/block_shield"
)
def block_shield():
    @s.add_tag('block_shield')

# -------------------------------
#  Detect windbursting                            
# -------------------------------

@event('minecraft:player_hurt_entity',
    {
        "player": {

            "equipment": {
                "mainhand": {
                    "predicates": {
                        "minecraft:enchantments": [
                            {
                                "enchantments": "minecraft:wind_burst"
                            }
                        ]
                    }
                }
            },
            "movement": {
                "fall_distance": {
                    "min": 1.5
                }
            }
        }
    },
    name="stunslam_detect/wind_burst"
)
def wind_burst():
    say wind_burst
    with at(@s):
        if @s[tag=block_shield]:
            incr_score()
            @s.remove_tag('block_shield')
            @s.add_tag('new_round')

# -------------------------------
#  Detect landing                            
# -------------------------------

on_ground_timer = Objective('on_ground_timer')

is_on_ground = add_predicate('stunslam_detect/on_ground', {
	"condition": "minecraft:entity_properties",
	"entity": "this",
	"predicate": {
		"flags": {
			"is_on_ground": True
		}
	}
})

@export('stunslam_detect/check_on_ground')
def check_on_ground():
    if is_on_ground:
        on_ground_timer[@s] += 1
    else:
        on_ground_timer[@s] = 0

    if on_ground_timer[@s] >= 10 or motion_y[@s] >= 15000:
        if @s[tag=new_round]:
            @s.remove_tag('new_round')
            @s.remove_tag('block_shield')
            reset_streak()

    if motion_y[@s] >= 15000:
        @s.add_tag('new_round')
