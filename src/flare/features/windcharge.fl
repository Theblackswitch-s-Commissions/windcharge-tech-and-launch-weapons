add_enchantment('internal/windcharge_explode', {
	"description": {
		"text": "This enchantment is used internally. Use at own risk!",
		"color": "red"
	},
	"anvil_cost": 2,
	"effects": {
		"minecraft:location_changed": [
			{
				"requirements": {
					"condition": "minecraft:enchantment_active_check",
					"active": False
				},
				"effect": {
					"type": "minecraft:explode",
					"attribute_to_user": True,
					"knockback_multiplier": 4,
					"radius": 3.5,
					"create_fire": False,
					"block_interaction": "trigger",
					"small_particle": {
						"type": "minecraft:gust"
					},
					"large_particle": {
						"type": "minecraft:gust_emitter_small"
					},
					"sound": "minecraft:entity.wind_charge.wind_burst"
				}
			},
			{
				"effect": {
					"type": "minecraft:run_function",
					"function": "tg:windcharge/explode/reset"
				}
			}
		]
	},
	"max_cost": {
		"base": 55,
		"per_level_above_first": 20
	},
	"max_level": 2,
	"min_cost": {
		"base": 5,
		"per_level_above_first": 20
	},
	"slots": [
		"feet"
	],
	"supported_items": "minecraft:poisonous_potato",
	"weight": 5
})

@export('windcharge/explode/reset')
def explode_reset():
    item replace entity @s armor.feet with air
    kill @s


@export('windcharge/explode/run')
def explode_run(dist: macro):
    summon minecraft:armor_stand ~ ~-$dist ~ {
        Invisible:1b,
        small:1b,
        "equipment":{
            "feet":{
                "id":"minecraft:poisonous_potato",
                "components":{
                    "minecraft:enchantments":{
                        "tg:internal/windcharge_explode":1
                    },
                    "minecraft:equippable":{
                        "slot":"feet"
                    }
                }
            }
        }
    }
    particle electric_spark ~ ~-$dist ~


prev_pos_y = Objective('prev_pos_y', type="dummy");

motion_y = Objective('motion_y', type="dummy");


@tick(name="windcharge/calc_player_motion")
def calc_player_motion():
    with @a:
        temp['#curr_pos_x', 3] = @s.Pos[0]
        temp['#curr_pos_y', 3] = @s.Pos[1]
        temp['#curr_pos_z', 3] = @s.Pos[2]

        motion_y[@s, 3] = temp["#curr_pos_y", 3] - prev_pos_y[@s, 3]

        prev_pos_y[@s, 3] = temp["#curr_pos_y", 3]
    

# -------------------------------
#  Windcharge checks / summons                            
# -------------------------------

@export('windcharge/use')
def on_use_windcharge():
    use_windcharge[@s] = 0;

    if server_data["windcharge_enabled"] != 1:
        return fail

    # Modify the windcharge
    windcharge = @n[type=minecraft:wind_charge]

    if motion_y[@s] <= -250 and is_above_ground and @s[x_rotation=70..]:
    
        # calculate the distance of the explosion
        explosion_multiplier = 4
        temp["dist", 3] = 7 * (explosion_multiplier + 0.8 * (motion_y[@s, 3] + 0.08)) / explosion_multiplier
        if temp["dist", 3] < 0:
            temp["dist", 3] = 0

        explode_run(temp["dist", 3])
            
        windcharge.kill()



# -------------------------------
#  Enabling / disabling                            
# -------------------------------

@tag('windcharge/enable')
@export('windcharge/enable')
def enable():
    server_data['windcharge_enabled'] = 1

@tag('windcharge/disable')
@export('windcharge/disable')
def disable():
    server_data['windcharge_enabled'] = 0
