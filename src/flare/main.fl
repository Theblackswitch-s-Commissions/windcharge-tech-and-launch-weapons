from flare import *
from .features.windcharge import *
from .features.score_menu import *
from .features.stunslam_detect import *
from .features.special_weapons import *


@load
def load():
    print("Template reloaded!", color="green");
    function #theblackswitch:__version__/easing/enable
    function #theblackswitch:__version__/clear_item/enable
    function #theblackswitch:__version__/slow_tick/enable
    forceload add 0 0

# Runs as the player
@export('player')
def player():
    if use_windcharge[@s] > 0:
        on_use_windcharge()
    check_on_ground()
    special_weapons_tick()

@tick(name="tick")
def tick():
    with as(@a).at(@s):
        if not @s[name=Stunslam]:
            player()


